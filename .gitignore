# Godot 4+ specific ignores
.godot/
/android/
.import/
export.cfg
export_credentials.cfg
*.tmp

# Local Android SDK and NDK for this repo. Other projects keep their own copies.
/.android/

# Build output
bin/
*.os
*.o
.sconsign.dblite
__pycache__/
/export/

# GDDocs output; the site build regenerates it
clients/*/docs/api/
/_site/

# Impeccable review captures are transient
.impeccable/review/
